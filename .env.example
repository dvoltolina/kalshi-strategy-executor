# Kalshi API Authentication
KALSHI_API_KEY_ID=your-api-key-id
KALSHI_PRIVATE_KEY_PATH=/path/to/private-key.pem

# Optional: API base URL (defaults to production)
# KALSHI_API_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# Required for guarded trading/event start-time checks
XAI_API_KEY=

# Runtime behavior
DRY_RUN=true
LOG_LEVEL=INFO

# Optional: Subaccount for isolated trading (1-32)
# SUBACCOUNT_NUMBER=1

# Database path for order tracking
DATABASE_PATH=data/orders.db

# Legacy: Used by old single-strategy mode (deprecated)
# CONTRACT_COUNT=10
# MIN_YES_PRICE=0.02
# MAX_YES_PRICE=0.19
# SPORTS_CATEGORIES=Sports,NFL,NBA,MLB,NHL
